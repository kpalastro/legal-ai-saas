# LexSim API — v1 local (verified working values; see TECH_STACK.md "Localhost v1")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434          # host process; compose overrides to host.docker.internal
LLM_MODEL=qwen3.5:0.8b                          # local smoke tier; pull qwen3.5:latest for quality

# Dev compose publishes postgres on :5434 (NOT :5432 — that port belongs to
# another local stack on this machine). Inside compose the host is `postgres`.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/lexsim
# Containers use the dedicated login role (dev password only):
# DATABASE_URL=postgresql+asyncpg://lexsim_api:lexsim_api_dev@localhost:5434/lexsim
REDIS_URL=redis://localhost:6379/0
GOTRUE_URL=http://localhost:9999
SUPABASE_JWT_SECRET=dev-only-jwt-secret-change-me
# Optional GoTrue admin API, used to delete the auth identity during erasure.
# GOTRUE_ADMIN_URL=http://localhost:9999
# GOTRUE_SERVICE_ROLE_KEY=
# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional external error sink; unset = no egress.
# SENTRY_DSN=

# Least-privilege app role. Every request transaction runs SET LOCAL ROLE;
# the connection user (postgres in dev) would otherwise bypass RLS.
DB_APP_ROLE=lexsim_app
DB_REQUIRE_NON_SUPERUSER=true

# Uploads: stored outside the web root; 20 MB cap.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=20971520

# Email (dev: Mailpit catch-all; compose worker overrides to mailpit:1025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=lexsim@localhost

# Stripe (unset = checkout returns 503 rather than faking a payment).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_AUTOMATIC_TAX=true
# STRIPE_TRIAL_DAYS=0
# CHECKOUT_SUCCESS_URL=http://localhost:3000/?billing=success
# CHECKOUT_CANCEL_URL=http://localhost:3000/?billing=cancel

# Phase 2 swap — zero code change (bedrock.py adapter):
# LLM_PROVIDER=bedrock
# BEDROCK_REGION=ap-southeast-2                  # startup ValidationError on anything else
# BEDROCK_MODEL=openai.gpt-oss-120b-1:0
