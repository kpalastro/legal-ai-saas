# LexSim API — v1 local (verified working values; see TECH_STACK.md "Localhost v1")
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434          # host process; compose overrides to host.docker.internal
LLM_MODEL=qwen3.5:latest                        # CI smoke: qwen3.5:0.8b · integration: qwen3.5-fast:latest

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lexsim
REDIS_URL=redis://localhost:6379/0
GOTRUE_URL=http://localhost:9999
SUPABASE_JWT_SECRET=dev-only-jwt-secret-change-me

